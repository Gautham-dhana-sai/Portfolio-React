# Nishi AI Chatbot Configuration
# Base URL of the RAG backend service (no trailing slash)
VITE_NISHI_API_BASE_URL=https://rag-bot-server.vercel.app

# Analytics attribution header sent on every Nishi API request
VITE_NISHI_REQUEST_ORIGIN=external_integration

# Request timeouts in milliseconds
VITE_NISHI_DEFAULT_TIMEOUT_MS=120000
VITE_NISHI_SEND_TIMEOUT_MS=180000

# Default conversation title created for new sessions
VITE_NISHI_CHAT_TITLE=Nishi Chat
